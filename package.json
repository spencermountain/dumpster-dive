{
  "author": "Spencer Kelly <spencermountain@gmail.com> (https://spencermountain.dev)",
  "name": "dumpster-dive",
  "description": "parse a wikipedia dump into json",
  "version": "6.0.0",
  "type": "module",
  "bin": {
    "dumpster": "./bin/dumpster.js"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "make-fixture": "node ./tests/make-fixture.js",
    "lint": "eslint ."
  },
  "repository": "github:spencermountain/dumpster-dive",
  "prettier": {
    "trailingComma": "none",
    "semi": true,
    "singleQuote": true,
