  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin/",
    "src/"
  ],
  "dependencies": {
    "prompts": "^2.4.2",
    "unbzip2-stream": "^1.4.3",
